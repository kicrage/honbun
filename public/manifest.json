{
  "manifest_version": 3,
  "name": "Honbun",
  "version": "1.0.0",
  "description": "次世代デジタルライブラリー（テキストモード）の全文を、範囲・書式を指定してテキスト/Markdownで保存します。",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Honbun",
    "default_popup": "app.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "storage", "sidePanel"],
  "host_permissions": ["https://lab.ndl.go.jp/*", "https://dl.ndl.go.jp/*"]
}
